# RUST SIGNAL — static browser game (HTTP).
# Substitute __DOMAIN__ (DNS name or IPv4 Host regex) and __WEB_ROOT__.
# For HTTPS with a domain, configure a suitable certificate separately.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __WEB_ROOT__;
    index index.html;
    charset utf-8;
    autoindex off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # A new site deployment must not serve the previous HTML entry from cache.
    location = / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files /index.html =404;
    }
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }
    # Vite emits content-hashed JS/CSS, safe to cache for a year.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    # Phaser art/atlas names are not content-hashed. Keep their cache short.
    location ~* \.(?:webp|png|jpe?g|gif|svg|json|ico|woff2?)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }
    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }
    # This is a single-page game without client-side routes. Unknown files
    # must return real 404 errors instead of silently serving index.html.
    location / {
        try_files $uri $uri/ =404;
    }
}
